# Copie ce fichier en .env puis remplis-le. Ne partage jamais ton .env.

# paper   : prix réels, ordres simulés en local, aucune clé nécessaire
# testnet : testnet Binance (https://testnet.binance.vision), faux argent
# demo    : demo trading Binance (https://demo.binance.com), faux argent, prix réels
# live    : ARGENT RÉEL (exige CONFIRM_LIVE_TRADING=OUI et MAX_CAPITAL)
MODE=paper

EXCHANGE=binance
SYMBOL=BTC/USDT
TIMEFRAME=1h

# Plusieurs bots en même temps, au format PAIRE@UNITE séparés par des virgules.
# En mode paper, chacun a son propre compte fictif de PAPER_START_BALANCE.
# Sur un vrai compte (testnet, demo, live), MAX_CAPITAL est obligatoire : c'est le montant de CHAQUE bot.
# Vide = un seul bot, SYMBOL@TIMEFRAME.
BOTS=BTC/USDT@15m,BTC/USDT@1h,BTC/USDT@1d

API_KEY=
API_SECRET=
# Uniquement pour les plateformes qui demandent une passphrase (OKX, KuCoin...)
API_PASSWORD=

# Montant max (en devise de cotation, ex. USDT) confié à chaque bot. Obligatoire en live.
MAX_CAPITAL=0
CONFIRM_LIVE_TRADING=

PAPER_START_BALANCE=10000

# --- Exécution des ordres ---
# market : ordres au marché | limit : ordres limites post-only (frais maker, voir README)
ORDER_TYPE=market
# Frais taker (au marché) et maker (ordre limite). `python main.py check` affiche ceux de ton compte.
FEE_RATE=0.001
MAKER_FEE_RATE=0.001
SLIPPAGE=0.0005
# Durée de vie d'un ordre limite, en bougies
LIMIT_TIMEOUT_BARS=1
# Achat limite non exécuté à temps : skip (abandon) ou market (achat au marché)
LIMIT_ENTRY_FALLBACK=skip
POLL_SECONDS=30

# --- Risque ---
RISK_PER_TRADE=0.01
MAX_POSITION_PCT=0.95
DAILY_LOSS_LIMIT=0.03
MAX_DRAWDOWN=0.15
# Après ce nombre de trades, une stratégie qui perd nettement n'ouvre plus de position (0 = jamais).
ELIMINATE_AFTER_TRADES=20

# --- Stratégie (laisser vide = valeurs par défaut) ---
# Acheter un repli : retour_moyenne (défaut, RSI) | bollinger
# Suivre une tendance : cassure | bollinger_cassure | croisement | macd | momentum | supertrend
# Sauter sur un mouvement soudain : impulsion (hausse d'au moins IMPULSE_PCT en IMPULSE_BARS bougies)
# Le laboratoire (« 6 - Laboratoire de strategies ») affiche les lignes exactes à copier ici.
STRATEGY_TYPE=
TREND_PERIOD=
RSI_PERIOD=
RSI_ENTRY=
EXIT_PERIOD=
BB_PERIOD=
BB_STD=
BREAKOUT_PERIOD=
BREAKOUT_EXIT_PERIOD=
FAST_PERIOD=
SLOW_PERIOD=
MACD_FAST=
MACD_SLOW=
MACD_SIGNAL=
MOMENTUM_PERIOD=
ST_PERIOD=
ST_MULT=
IMPULSE_BARS=
IMPULSE_PCT=
ATR_PERIOD=
STOP_ATR_MULT=
MAX_BARS_IN_TRADE=
# Filtres d'achat (0 ou vide = sans filtre) : volatilité minimale (ATR / prix, 0.003 = 0,3 %),
# volume minimal en multiple de sa moyenne sur VOLUME_PERIOD bougies (2 = deux fois la moyenne).
MIN_ATR_PCT=
VOLUME_MULT=
VOLUME_PERIOD=
# Heures UTC d'achat (13-21 = de 13 h à 21 h UTC), et compression des bandes de Bollinger avant une cassure
# (0.2 = bandes parmi les 20 % les plus serrées des SQUEEZE_PERIOD dernières bougies).
ACTIVE_HOURS=
SQUEEZE_QUANTILE=
SQUEEZE_PERIOD=

# --- Les 15 bots (argent fictif seulement : long terme, court terme, scalping) ---
# Vide = valeur par défaut. Pris en compte au prochain « Choisir les 15 bots ».
# Capital fictif de chaque bot, en USDT (1000 par défaut).
FLOTTE_CAPITAL=
# Levier maximum de chaque équipe, de 1 à 20 (1, 3 et 5 par défaut). Réduit pour un trade dont le stop est loin :
# le stop passe toujours avant la liquidation. Le levier ne crée aucun gain : il grossit gains et pertes.
FLOTTE_LEVIER_LONG=
FLOTTE_LEVIER_COURT=
FLOTTE_LEVIER_SCALPING=
# Cryptos testées : les plus échangées (15 par défaut) et, en plus, les plus agitées du moment (10 par défaut).
FLOTTE_CRYPTOS=
FLOTTE_AGITEES=

# --- Alertes sur ton téléphone par Telegram (optionnel, gratuit) ---
# 1. Dans Telegram, écris à @BotFather, envoie /newbot et suis les étapes : colle ici le « token » qu'il donne.
# 2. Écris un message à ton nouveau bot, puis lance « 12 - Tester les alertes Telegram » : il affiche l'identifiant
#    de ta discussion à recopier dans TELEGRAM_CHAT_ID, et t'envoie un message de test.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Journal Obsidian (optionnel) ---
# Chemin d'un coffre Obsidian : le bot y écrit ses trades, ses backtests et son journal. Vide = désactivé.
OBSIDIAN_VAULT=
