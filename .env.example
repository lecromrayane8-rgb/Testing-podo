# Copie ce fichier en .env puis remplis-le. Ne partage jamais ton .env.

# paper   : prix réels, ordres simulés en local, aucune clé nécessaire
# testnet : testnet Binance (https://testnet.binance.vision), faux argent
# demo    : demo trading Binance (https://demo.binance.com), faux argent, prix réels
# live    : ARGENT RÉEL (exige CONFIRM_LIVE_TRADING=OUI et MAX_CAPITAL)
MODE=paper

EXCHANGE=binance
SYMBOL=BTC/USDT
TIMEFRAME=1h

API_KEY=
API_SECRET=
# Uniquement pour les plateformes qui demandent une passphrase (OKX, KuCoin...)
API_PASSWORD=

# Montant max (en devise de cotation, ex. USDT) confié au bot. Obligatoire en live.
MAX_CAPITAL=0
CONFIRM_LIVE_TRADING=

PAPER_START_BALANCE=10000
# --- Exécution des ordres ---
# market : ordres au marché | limit : ordres limites post-only (frais maker, voir README)
ORDER_TYPE=market
# Frais taker (au marché) et maker (ordre limite). `python main.py check` affiche ceux de ton compte.
FEE_RATE=0.001
MAKER_FEE_RATE=0.001
SLIPPAGE=0.0005
# Durée de vie d'un ordre limite, en bougies
LIMIT_TIMEOUT_BARS=1
# Achat limite non exécuté à temps : skip (abandon) ou market (achat au marché)
LIMIT_ENTRY_FALLBACK=skip
POLL_SECONDS=30

# --- Risque ---
RISK_PER_TRADE=0.01
MAX_POSITION_PCT=0.95
DAILY_LOSS_LIMIT=0.03
MAX_DRAWDOWN=0.15

# --- Stratégie (laisser vide = valeurs par défaut) ---
TREND_PERIOD=
RSI_PERIOD=
RSI_ENTRY=
EXIT_PERIOD=
ATR_PERIOD=
STOP_ATR_MULT=
MAX_BARS_IN_TRADE=
